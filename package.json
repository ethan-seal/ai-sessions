{
  "name": "ai-sessions",
  "version": "2.0.0",
  "type": "module",
  "bin": {
    "ai-sessions": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outfile dist/ai-sessions.js --target bun",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && biome check . && bun test"
  },
  "devDependencies": {
    "bun-types": "^1.3.11",
    "typescript": "^6.0.3"
  }
}
